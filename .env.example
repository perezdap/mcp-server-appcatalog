# Transport: stdio | sse | streamable-http
APPCATALOG_TRANSPORT=stdio
APPCATALOG_HOST=0.0.0.0
APPCATALOG_PORT=8010

# Cache
APPCATALOG_CACHE_DIR=./data
APPCATALOG_CACHE_TTL_HOURS=6

# Source selection ----------------------------------------------------------
# Which winget backend: "auto" (try GitHub then winget.run), "github", or "winget.run"
APPCATALOG_WINGET_API=auto
# Optional GitHub token — raises rate limit from 60 to 5000 req/hour
GITHUB_TOKEN=

# Chocolatey OData v2 API base URL
APPCATALOG_CHOCO_API=https://community.chocolatey.org/api/v2/

# Evergreen REST API base URL (vendor-direct latest-version + download URLs)
APPCATALOG_EVERGREEN_API=https://evergreen-api.stealthpuppy.com

# Silent Install HQ MCP server (streamable-http endpoint, optional)
APPCATALOG_SIHQ_URL=http://127.0.0.1:8000/mcp

# Polite scraping ------------------------------------------------------------
APPCATALOG_USER_AGENT=mcp-server-appcatalog/0.1.0 (+https://github.com/perezdap/mcp-server-appcatalog)
APPCATALOG_REQUEST_DELAY_SECONDS=0.5
APPCATALOG_REQUEST_TIMEOUT_SECONDS=30
APPCATALOG_HTTPX_MAX_CONNECTIONS=10
APPCATALOG_HTTPX_MAX_KEEPALIVE_CONNECTIONS=4

# verify_hash streaming download cap in bytes (default 500 MB)
APPCATALOG_VERIFY_MAX_BYTES=524288000
# Best-effort verify_hash SSRF guard: reject URLs/redirect hops resolving to
# loopback/private/link-local hosts. Not DNS-rebind-proof; keep behind a trusted
# agent. Set to false only for trusted internal-only deployments.
APPCATALOG_VERIFY_BLOCK_PRIVATE_HOSTS=true

# Logging
APPCATALOG_LOG_LEVEL=INFO
